Rung Number="45" Type="N"><Comment>Pagination example 46: repeated captured call; execution remains unproven.</Comment><Text><![CDATA[XIC(Permit)JSR(Worker,0);]]></Text></Rung><Rung Number="46" Type="N"><Comment>Pagination example 47: repeated captured call; execution remains unproven.</Comment><Text><![CDATA[XIC(Permit)JSR(Worker,0);]]></Text></Rung><Rung Number="47" Type="N"><Comment>Pagination example 48: repeated captured call; execution remains unproven.</Comment><Text><![CDATA[XIC(Permit)JSR(Worker,0);]]></Text></Rung><Rung Number="48" Type="N"><Comment>Pagination example 49: repeated captured call; execution remains unproven.</Comment><Text><![CDATA[XIC(Permit)JSR(Worker,0);]]></Text></Rung><Rung Number="49" Type="N"><Comment>Pagination example 50: repeated captured call; execution remains unproven.</Comment><Text><![CDATA[XIC(Permit)JSR(Worker,0);]]></Text></Rung><Rung Number="50" Type="N"><Comment>Pagination example 51: repeated captured call; execution remains unproven.</Comment><Text><![CDATA[XIC(Permit)JSR(Worker,0);]]></Text></Rung><Rung Number="51" Type="N"><Comment>Pagination example 52: repeated captured call; execution remains unproven.</Comment><Text><![CDATA[XIC(Permit)JSR(Worker,0);]]></Text></Rung><Rung Number="52" Type="N"><Comment>Pagination example 53: repeated captured call; execution remains unproven.</Comment><Text><![CDATA[XIC(Permit)JSR(Worker,0);]]></Text></Rung><Rung Number="53" Type="N"><Comment>Pagination example 54: repeated captured call; execution remains unproven.</Comment><Text><![CDATA[XIC(Permit)JSR(Worker,0);]]></Text></Rung><Rung Number="54" Type="N"><Comment>Pagination example 55: repeated captured call; execution remains unproven.</Comment><Text><![CDATA[XIC(Permit)JSR(Worker,0);]]></Text></Rung><Rung Number="55" Type="N"><Comment>Pagination example 56: repeated captured call; execution remains unproven.</Comment><Text><![CDATA[XIC(Permit)JSR(Worker,0);]]></Text></Rung><Rung Number="56" Type="N"><Comment>Nested alternatives preserve each incoming condition path.</Comment><Text><![CDATA[XIC(Permit)[XIO(Trip)JSR(Worker,0),[XIC(A)JSR(Worker,1,A),XIC(B)JSR(Missing,0)]];]]></Text></Rung><Rung Number="57" Type="N"><Comment>Stored one-shot state is part of the incoming condition.</Comment><Text><![CDATA[XIC(Permit)ONS(Edge)JSR(Worker,0);]]></Text></Rung><Rung Number="58" Type="N"><Comment>Unknown preceding instruction leaves the incoming transfer unresolved.</Comment><Text><![CDATA[MysteryGuard(A)JSR(Worker,0);]]></Text></Rung><Rung Number="59" Type="N"><Comment>Wholly invented execution-context demonstration.</Comment><Text><![CDATA[JSR(Duplicate,0)JSR(STOnly,0)JSR(NoBody,0);]]></Text></Rung><Rung Number="60" Type="N"><Comment>Captured parameter spellings remain unvalidated.</Comment><Text><![CDATA[JSR(Worker,,)JSR(Worker,2,A,B,Out);]]></Text></Rung><Rung Number="61" Type="N"><Comment>A label in another routine cannot settle this jump.</Comment><Text><![CDATA[JMP(Elsewhere);]]></Text></Rung><Rung Number="62" Type="N"><Comment>Nested branch results join before this routine call.</Comment><Text><![CDATA[[XIC(A),[XIO(B),XIC(Trip)]]JSR(Worker,0);]]></Text></Rung></RLLContent></Routine><Routine Name="Worker" Type="RLL" ><RLLContent><Rung Number="0" Type="N"><Text><![CDATA[SBR(A,B);]]></Text></Rung><Rung Number="1" Type="N"><Text><![CDATA[XIC(A)JMP(Target);]]></Text></Rung><Rung Number="2" Type="N"><Text><![CDATA[LBL(Target);]]></Text></Rung><Rung Number="3" Type="N"><Text><![CDATA[LBL(Target);]]></Text></Rung><Rung Number="4" Type="N"><Text><![CDATA[JMP(MissingLabel);]]></Text></Rung><Rung Number="5" Type="N"><Text><![CDATA[LBL(Elsewhere);]]></Text></Rung><Rung Number="6" Type="N"><Text><![CDATA[RET(Out);]]></Text></Rung></RLLContent></Routine><Routine Name="Fault" Type="RLL" ><RLLContent><Rung Number="0" Type="N"><Text><![CDATA[RET();]]></Text></Rung></RLLContent></Routine><Routine Name="NamespaceBody" Type="RLL" x:Marker="foreign metadata"><RLLContent><Rung Number="0" Type="N"><Text><![CDATA[XIC(Permit)JSR(Worker,0);]]></Text></Rung></RLLContent></Routine><Routine Name="Duplicate" Type="RLL" ><RLLContent><Rung Number="0" Type="N"><Text><![CDATA[NOP();]]></Text></Rung></RLLContent></Routine><Routine Name="Duplicate" Type="RLL" ><RLLContent><Rung Number="0" Type="N"><Text><![CDATA[NOP();]]></Text></Rung></RLLContent></Routine>
<Routine Name="STOnly" Type="ST"><STContent><Line Number="0">Out := 1;</Line></STContent></Routine>
<Routine Name="NoBody" Type="RLL"/>
</Routines></Program>
<Program Name="Repeated" MainRoutineName="MissingMain" FaultRoutineName=""><Routines/></Program>
<Program Name="Repeated" MainRoutineName="Duplicate" FaultRoutineName="MissingFault"><Routines><Routine Name="Duplicate" Type="RLL" ><RLLContent><Rung Number="0" Type="N"><Text><![CDATA[NOP();]]></Text></Rung></RLLContent></Routine><Routine Name="Duplicate" Type="RLL" ><RLLContent><Rung Number="0" Type="N"><Text><![CDATA[NOP();]]></Text></Rung></RLLContent></Routine></Routines></Program>
<Program Name="NoMain"><Routines><Routine Name="Idle" Type="RLL" ><RLLContent><Rung Number="0" Type="N"><Text><![CDATA[NOP();]]></Text></Rung></RLLContent></Routine></Routines></Program>
<Program Name="ForeignProgram" MainRoutineName="ForeignMain" x:Marker="foreign program"><Routines><Routine Name="ForeignMain" Type="RLL" ><RLLContent><Rung Number="0" Type="N"><Text><![CDATA[JSR(ForeignMain,0);]]></Text></Rung></RLLContent></Routine></Routines></Program>
</Programs></Controller></RSLogix5000Content>
