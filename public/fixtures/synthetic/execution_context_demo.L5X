<?xml version="1.0" encoding="UTF-8"?>
<!-- Entirely invented. Contains no plant source, identifiers or operating values. -->
<RSLogix5000Content SoftwareRevision="35.00" xmlns:x="urn:invented-extension">
<Controller Name="InventedExecutionDemo">
<Description>Execution context demo &lt;img src=x onerror=alert(1)&gt; &amp; local evidence.</Description>
<Tags><Tag Name="Permit" DataType="BOOL"/><Tag Name="Trip" DataType="BOOL"/>
<Tag Name="A" DataType="BOOL"/><Tag Name="B" DataType="BOOL"/><Tag Name="Edge" DataType="BOOL"/><Tag Name="Out" DataType="REAL"/></Tags>
<Tasks>
<Task Name="Periodic &lt;demo &amp; proof&gt;" Type="PERIODIC" Rate="010.00" Priority="07" Watchdog="00500" DisableUpdateOutputs="false">
<ScheduledPrograms><ScheduledProgram Name="Demo"/><ScheduledProgram Name="Demo"/><ScheduledProgram Name="Repeated"/><ScheduledProgram Name="MissingProgram"/><ScheduledProgram/></ScheduledPrograms></Task>
<Task Name="EventTask" Type="EVENT" Priority="3" Watchdog="raw unknown">
<EventInfo EventTrigger="EVENT_INSTRUCTION" EnableTimeout="true" Timeout="001.500"/>
<ScheduledPrograms><ScheduledProgram Name="Demo"/><ScheduledProgram Name="NoMain"/></ScheduledPrograms></Task>
<Task Name="UnqualifiedTask" Type="CONTINUOUS" x:Marker="&lt;script&gt;not markup&lt;/script&gt;"><ScheduledPrograms><ScheduledProgram Name="Demo"/></ScheduledPrograms></Task>
<Task Name="ForeignSchedule" Type="CONTINUOUS"><ScheduledPrograms><ScheduledProgram Name="Demo" x:Marker="foreign"/></ScheduledPrograms></Task>
</Tasks>
<Programs>
<Program Name="Demo" MainRoutineName="Main" FaultRoutineName="Fault" Disabled="true"><Routines>
