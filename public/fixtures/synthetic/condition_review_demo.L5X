      <Tag Name="DEMO_FLOW_OUT" TagType="Base" DataType="REAL"/>
      <Tag Name="DEMO_FLOW_PID" TagType="Base" DataType="PID">
        <Data Format="Decorated"><Structure DataType="PID">
          <DataValueMember Name="SP" DataType="REAL" Radix="Float" Value="42.5"/>
          <DataValueMember Name="KP" DataType="REAL" Radix="Float" Value="1.25"/>
          <DataValueMember Name="MAXO" DataType="REAL" Radix="Float" Value="90.0"/>
        </Structure></Data>
      </Tag>
      <Tag Name="DEMO_TIMER" TagType="Base" DataType="TIMER">
        <Data Format="L5K"><![CDATA[[0,2500,0]]]></Data>
        <Data Format="Decorated"><Structure DataType="TIMER">
          <DataValueMember Name="PRE" DataType="DINT" Radix="Decimal" Value="2500"/>
          <DataValueMember Name="ACC" DataType="DINT" Radix="Decimal" Value="0"/>
          <DataValueMember Name="DN" DataType="BOOL" Value="0"/>
        </Structure></Data>
      </Tag>
