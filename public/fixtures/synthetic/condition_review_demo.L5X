      <Tag Name="DEMO_UNRESOLVED_ALIAS" TagType="Alias" DataType="BOOL" AliasFor="DEMO_MISSING_SOURCE"/>
      <Tag Name="DEMO_ARRAY" TagType="Base" DataType="DINT" Dimensions="3">
        <Data Format="Decorated"><Array DataType="DINT" Dimensions="3" Radix="Decimal">
          <Element Index="[0]" Value="7"/><Element Index="[1]" Value="11"/><Element Index="[2]" Value="13"/>
        </Array></Data>
      </Tag>
      <Tag Name="DEMO_LABEL" TagType="Base" DataType="STRING">
        <Data Format="String" Length="12"><![CDATA['Demo / essai']]></Data>
      </Tag>
      <Tag Name="DEMO_DUPLICATE" TagType="Base" DataType="DINT">
        <Data Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="4"/></Data>
        <Data Format="Decorated"><DataValue DataType="DINT" Radix="Decimal" Value="9"/></Data>
      </Tag>
      <Tag Name="DEMO_VENDOR_DATA" TagType="Base" DataType="DINT">
        <Data Format="Vendor"><Payload Version="invented">Opaque demonstration</Payload></Data>
      </Tag>
      <Tag Name="DEMO_PID_ALIAS" TagType="Alias" DataType="PID" AliasFor="DEMO_FLOW_PID"/>
      <Tag Name="DEMO_SECOND_PID" TagType="Base" DataType="PID">
        <Data Format="L5K"><![CDATA[[0,25,1]]]></Data>
        <Data Format="Decorated"><Structure DataType="PID">
          <DataValueMember Name="SP" DataType="REAL" Value="25"/>
          <DataValueMember Name="KP" DataType="REAL" Value="2"/>
          <DataValueMember Name="CL" DataType="BOOL" Value="0"/>
          <DataValueMember Name="CT" DataType="BOOL" Value="0"/>
        </Structure></Data>
        <Data Format="Decorated"><Structure DataType="PID">
          <DataValueMember Name="SP" DataType="REAL" Value="30"/>
          <DataValueMember Name="SP" DataType="REAL" Value="35"/>
        </Structure></Data>
      </Tag>
      <Tag Name="DEMO_EMPTY_PID" TagType="Base" DataType="PID"/>
      <Tag Name="DEMO_OPAQUE_PID" TagType="Base" DataType="PID">
        <Data Format="Vendor"><Payload>Invented opaque PID evidence</Payload></Data>
      </Tag>
      <Tag Name="DEMO_NESTED" TagType="Base" DataType="DEMO_WRAPPER">
        <Data Format="Decorated"><Structure DataType="DEMO_WRAPPER">
          <StructureMember Name="Loop" DataType="PID"><DataValueMember Name="SP" DataType="REAL" Value="17"/></StructureMember>
        </Structure></Data>
      </Tag>
<Tag Name="DEMO_CATALOG_PID" TagType="Base" DataType="PID"><Description>Invented member catalog demonstration; values are not approved settings.</Description><Data Format="Decorated"><Structure DataType="PID"><DataValueMember Name="CTL" DataType="DINT" Value="0"/><DataValueMember Name="SP" DataType="REAL" Value="1.0"/><DataValueMember Name="KP" DataType="REAL" Value="2.0"/><DataValueMember Name="KI" DataType="REAL" Value="3.0"/><DataValueMember Name="KD" DataType="REAL" Value="4.0"/><DataValueMember Name="BIAS" DataType="REAL" Value="5.0"/><DataValueMember Name="MAXS" DataType="REAL" Value="6.0"/><DataValueMember Name="MINS" DataType="REAL" Value="7.0"/><DataValueMember Name="DB" DataType="REAL" Value="8.0"/><DataValueMember Name="SO" DataType="REAL" Value="9.0"/><DataValueMember Name="MAXO" DataType="REAL" Value="10.0"/><DataValueMember Name="MINO" DataType="REAL" Value="11.0"/><DataValueMember Name="UPD" DataType="REAL" Value="12.0"/><DataValueMember Name="PV" DataType="REAL" Value="13.0"/><DataValueMember Name="ERR" DataType="REAL" Value="14.0"/><DataValueMember Name="OUT" DataType="REAL" Value="15.0"/><DataValueMember Name="PVH" DataType="REAL" Value="16.0"/><DataValueMember Name="PVL" DataType="REAL" Value="17.0"/><DataValueMember Name="DVP" DataType="REAL" Value="18.0"/><DataValueMember Name="DVN" DataType="REAL" Value="19.0"/><DataValueMember Name="PVDB" DataType="REAL" Value="20.0"/><DataValueMember Name="DVDB" DataType="REAL" Value="21.0"/><DataValueMember Name="MAXI" DataType="REAL" Value="22.0"/><DataValueMember Name="MINI" DataType="REAL" Value="23.0"/><DataValueMember Name="TIE" DataType="REAL" Value="24.0"/><DataValueMember Name="MAXCV" DataType="REAL" Value="25.0"/><DataValueMember Name="MINCV" DataType="REAL" Value="26.0"/><DataValueMember Name="MINTIE" DataType="REAL" Value="27.0"/><DataValueMember Name="MAXTIE" DataType="REAL" Value="28.0"/><DataValueMember Name="EN" DataType="BOOL" Value="0"/><DataValueMember Name="CT" DataType="BOOL" Value="0"/><DataValueMember Name="CL" DataType="BOOL" Value="0"/><DataValueMember Name="PVT" DataType="BOOL" Value="0"/><DataValueMember Name="DOE" DataType="BOOL" Value="0"/><DataValueMember Name="SWM" DataType="BOOL" Value="0"/><DataValueMember Name="CA" DataType="BOOL" Value="0"/><DataValueMember Name="MO" DataType="BOOL" Value="0"/><DataValueMember Name="PE" DataType="BOOL" Value="0"/><DataValueMember Name="NDF" DataType="BOOL" Value="0"/><DataValueMember Name="NOBC" DataType="BOOL" Value="0"/><DataValueMember Name="NOZC" DataType="BOOL" Value="0"/><DataValueMember Name="INI" DataType="BOOL" Value="0"/><DataValueMember Name="SPOR" DataType="BOOL" Value="0"/><DataValueMember Name="OLL" DataType="BOOL" Value="0"/><DataValueMember Name="OLH" DataType="BOOL" Value="0"/><DataValueMember Name="EWD" DataType="BOOL" Value="0"/><DataValueMember Name="DVNA" DataType="BOOL" Value="0"/><DataValueMember Name="DVPA" DataType="BOOL" Value="0"/><DataValueMember Name="PVLA" DataType="BOOL" Value="0"/><DataValueMember Name="PVHA" DataType="BOOL" Value="0"/><ArrayMember Name="DATA" DataType="REAL" Dimensions="17"><Element Index="[0]" Value="0.0"/><Element Index="[1]" Value="0.0"/><Element Index="[2]" Value="0.0"/><Element Index="[3]" Value="0.0"/><Element Index="[4]" Value="0.0"/><Element Index="[5]" Value="0.0"/><Element Index="[6]" Value="0.0"/><Element Index="[7]" Value="0.0"/><Element Index="[8]" Value="0.0"/><Element Index="[9]" Value="0.0"/><Element Index="[10]" Value="0.0"/><Element Index="[11]" Value="0.0"/><Element Index="[12]" Value="0.0"/><Element Index="[13]" Value="0.0"/><Element Index="[14]" Value="0.0"/><Element Index="[15]" Value="0.0"/><Element Index="[16]" Value="0.0"/></ArrayMember></Structure></Data></Tag>
<Tag Name="DEMO_MEMBER_GAPS_PID" TagType="Base" DataType="PID"><Data Format="Decorated"><Structure DataType="PID">
<DataValueMember Name="SP" DataType="REAL" Value="10"/>
<DataValueMember Name="sp" DataType="DINT" Value="20"/>
<DataValueMember Name="KP" DataType="REAL" Value=""/>
<DataValueMember Name="KI" Value="1.5"/>
<DataValueMember Name="CL" DataType="BOOL" Value="saved-text-is-not-decoded"/>
<DataValueMember Name="DEMO_EXTENSION" DataType="REAL" Value="8"/>
<ArrayMember Name="DATA" DataType="REAL" Dimensions="2"><Element Index="[0]" Value="0"/><Element Index="[1]" Value="0"/></ArrayMember>
</Structure></Data></Tag>
<Tag Name="DEMO_LEVEL_ALIAS" TagType="Alias" DataType="REAL" AliasFor="DEMO_LEVEL"/>
<Tag Name="DEMO_INDEX" TagType="Base" DataType="DINT"/>

      <Tag Name="DEMO_COUNTER" TagType="Base" DataType="COUNTER"/>
      <Tag Name="DEMO_MESSAGE" TagType="Base" DataType="MESSAGE"/>
      <Tag Name="DEMO_MESSAGE_ALIAS" TagType="Alias" DataType="MESSAGE" AliasFor="DEMO_MESSAGE"/>
      <Tag Name="DEMO_SYSTEM_DEST" TagType="Base" DataType="DINT" Dimensions="11"/>
      <Tag Name="DEMO_SYSTEM_ALIAS" TagType="Alias" DataType="DINT" AliasFor="DEMO_SYSTEM_DEST[2]"/>
      <Tag Name="DEMO_WAIT" TagType="Base" DataType="SFC_STEP"/>
      <Tag Name="DEMO_STEP_ALIAS" TagType="Alias" DataType="SFC_STEP" AliasFor="DEMO_WAIT"/>
      <Tag Name="Controller" TagType="Base" DataType="DINT"/>
      <Tag Name="Name" TagType="Base" DataType="DINT"/>
      <Tag Name="DEMO_CHART" TagType="Base" DataType="DINT"/>
      <Tag Name="DEMO_EXPR_ONLY" TagType="Base" DataType="REAL"/>
      <Tag Name="DEMO_EXPR_ALIAS" TagType="Alias" DataType="REAL" AliasFor="DEMO_EXPR_ONLY"/>
      <Tag Name="DEMO_SELF_CALC" TagType="Base" DataType="REAL"/>
      <Tag Name="DEMO_SENSOR_INPUT" TagType="Base" DataType="BOOL"/>
      <Tag Name="DEMO_VALVE_COMMAND" TagType="Base" DataType="BOOL"/>
      <Tag Name="DEMO_ALARM_CONTROL" TagType="Base" DataType="ALARM_DIGITAL"/>
      <Tag Name="DEMO_CHAIN_INPUT" TagType="Base" DataType="REAL"/>
      <Tag Name="DEMO_CHAIN_OTHER" TagType="Base" DataType="REAL"/>
      <Tag Name="DEMO_CHAIN_MID" TagType="Base" DataType="REAL"/>
      <Tag Name="DEMO_CHAIN_OUT" TagType="Base" DataType="REAL"/>
      <Tag Name="DEMO_MID_ALIAS" TagType="Alias" AliasFor="DEMO_CHAIN_MID" DataType="REAL"/>
      <Tag Name="DEMO_PAIR" TagType="Base" DataType="DEMO_UNMODELED_PAIR"/>
      <Tag Name="DEMO_BITS" TagType="Base" DataType="DINT"/>
      <Tag Name="DEMO_BIT_ALIAS" TagType="Alias" AliasFor="DEMO_BITS.1" DataType="BOOL"/>
    </Tags>
    <Modules><Module Name="DEMO_IO" CatalogNumber="INVENTED"><Communications><Connections><Connection Name="InventedConnection"><InputTag Name="Local:7:I"/><OutputTag Name="Local:7:O"/></Connection></Connections></Communications></Module></Modules>
    <Tasks><Task Name="DEMO_TASK" Type="Periodic" Rate="100" Priority="10"><ScheduledPrograms><ScheduledProgram Name="DEMO_PROGRAM"/></ScheduledPrograms></Task></Tasks>
    <Programs><Program Name="DEMO_PROGRAM" Type="Normal" MainRoutineName="DEMO_MAIN">
      <Description><![CDATA[Source review sample — Québec / English descriptions retained as authored.]]></Description>
      <Routines>
        <Routine Name="DEMO_MAIN" Type="RLL"><RLLContent>
          <Rung Number="0" Type="N"><Comment><![CDATA[A simple source occurrence to find from the object page.]]></Comment><Text><![CDATA[XIC(DEMO_START)OTE(DEMO_PUMP_CMD);]]></Text></Rung>
          <Rung Number="1" Type="N"><Comment><![CDATA[Same opcode/arity shape, different operands. Shape equality does not establish equivalent behavior.]]></Comment><Text><![CDATA[XIC(DEMO_TRIP)OTE(DEMO_LEVEL_ALARM);]]></Text></Rung>
          <Rung Number="2" Type="N"><Text><![CDATA[[XIC(DEMO_START),XIC(DEMO_PUMP_FB)]XIO(DEMO_STOP)OTE(DEMO_PUMP_ALIAS);]]></Text></Rung>
          <Rung Number="3" Type="N"><Comment><![CDATA[Seven PID operand functions are shown; saved settings do not establish active loop behavior.]]></Comment><Text><![CDATA[PID(DEMO_FLOW_PID,DEMO_FLOW_PV,DEMO_TIEBACK,DEMO_FLOW_OUT,0,0,0);]]></Text></Rung>
          <Rung Number="4" Type="N"><Text><![CDATA[CPT(DEMO_CALC,DEMO_LEVEL * 2 + DEMO_FLOW_PV);]]></Text></Rung>
          <Rung Number="5" Type="N"><Text><![CDATA[XIC(DEMO_PERMISSIVE)TON(DEMO_TIMER,?,?);]]></Text></Rung>
          <Rung Number="6" Type="N"><Comment><![CDATA[Deliberate unknown instruction for the findings queue.]]></Comment><Text><![CDATA[DEMO_CUSTOM(DEMO_START,DEMO_PUMP_CMD);]]></Text></Rung>
          <Rung Number="7" Type="N"><Text><![CDATA[XIC(DEMO_MISSING_SOURCE)OTE(DEMO_LEVEL_ALARM);]]></Text></Rung>
          <Rung Number="8" Type="N"><Text><![CDATA[JSR(DEMO_CHART,0);]]></Text></Rung>
          <Rung Number="9" Type="N"><Text><![CDATA[GEQ(DEMO_LEVEL,80)OTE(DEMO_LEVEL_ALARM);]]></Text></Rung>
          <Rung Number="10" Type="N"><Comment><![CDATA[Explicit master operand only; CL is zero in one stored representation. No active cascade is asserted.]]></Comment><Text><![CDATA[PID(DEMO_SECOND_PID,DEMO_FLOW_PV,0,DEMO_FLOW_OUT,DEMO_FLOW_PID,0,0);]]></Text></Rung>
          <Rung Number="11" Type="N"><Comment><![CDATA[Second occurrence of the same backing declaration through an alias.]]></Comment><Text><![CDATA[pid(DEMO_PID_ALIAS,DEMO_FLOW_PV,0,DEMO_FLOW_OUT,0,0,0);]]></Text></Rung>
          <Rung Number="12" Type="N"><Text><![CDATA[PID(DEMO_EMPTY_PID,DEMO_FLOW_PV,0,DEMO_FLOW_OUT,0,0,0);]]></Text></Rung>
          <Rung Number="13" Type="N"><Text><![CDATA[PID(DEMO_OPAQUE_PID,DEMO_FLOW_PV,0,DEMO_FLOW_OUT,0,0,0);]]></Text></Rung>
          <Rung Number="14" Type="N"><Comment><![CDATA[Member suffix is retained; selecting nested storage is outside this slice.]]></Comment><Text><![CDATA[PID(DEMO_NESTED.Loop,DEMO_FLOW_PV,0,DEMO_FLOW_OUT,0,0,0);]]></Text></Rung>
          <Rung Number="15" Type="N"><Comment><![CDATA[Deliberately malformed six-slot PID stays visible without functional labels.]]></Comment><Text><![CDATA[PID(DEMO_FLOW_PID,DEMO_FLOW_PV,0,DEMO_FLOW_OUT,0,0);]]></Text></Rung>
<Rung Number="16" Type="N"><Text>PID(DEMO_CATALOG_PID,DEMO_FLOW_PV,0,DEMO_FLOW_OUT,0,0,0);</Text></Rung><Rung Number="17" Type="N"><Text>PID(DEMO_MEMBER_GAPS_PID,DEMO_FLOW_PV,0,DEMO_FLOW_OUT,0,0,0);</Text></Rung>
<Rung Number="18" Type="N"><Comment>Grouping, unary minus, and a repeated reference.</Comment><Text><![CDATA[CPT(DEMO_CALC,-(DEMO_LEVEL + DEMO_FLOW_PV) ** 2 + DEMO_LEVEL);]]></Text></Rung>
<Rung Number="19" Type="N"><Comment>Equal precedence is grouped left to right; no value is calculated.</Comment><Text><![CDATA[CPT(DEMO_CALC,2 ** 3 ** 2);]]></Text></Rung>
<Rung Number="20" Type="N"><Comment>Bitwise and arithmetic operators retained as syntax.</Comment><Text><![CDATA[CPT(DEMO_CALC,NOT DEMO_INDEX AND 16#FF OR DEMO_INDEX MOD 8);]]></Text></Rung>
<Rung Number="21" Type="N"><Comment>Documented single-argument function forms.</Comment><Text><![CDATA[CPT(DEMO_CALC,ABS(DEMO_LEVEL) + SQRT(DEMO_FLOW_PV));]]></Text></Rung>
<Rung Number="22" Type="N"><Comment>Alias expansion and static index suffix; no member or bounds validation.</Comment><Text><![CDATA[CPT(DEMO_CALC,DEMO_LEVEL_ALIAS + DEMO_ARRAY[1]);]]></Text></Rung>
<Rung Number="23" Type="N"><Comment>Dynamic subscript retained as one unsupported address; no index dependency inferred.</Comment><Text><![CDATA[CPT(DEMO_CALC,DEMO_ARRAY[DEMO_INDEX] + DEMO_LEVEL);]]></Text></Rung>
<Rung Number="24" Type="N"><Comment>Unresolved source root remains explicit.</Comment><Text><![CDATA[CPT(DEMO_CALC,DEMO_MISSING_SOURCE + DEMO_LEVEL);]]></Text></Rung>
<Rung Number="25" Type="N"><Comment>Unknown function leaves the whole expression unsupported, with no partial tree.</Comment><Text><![CDATA[CPT(DEMO_CALC,DEMO_FN(DEMO_LEVEL) + DEMO_FLOW_PV);]]></Text></Rung>
<Rung Number="26" Type="N"><Comment>Unsupported comparison leaves no partial tree.</Comment><Text><![CDATA[CPT(DEMO_CALC,DEMO_LEVEL > 2);]]></Text></Rung>
<Rung Number="27" Type="N"><Comment>Incomplete expression leaves no partial tree.</Comment><Text><![CDATA[CPT(DEMO_CALC,DEMO_LEVEL +);]]></Text></Rung>
<Rung Number="28" Type="N"><Comment>Numeric spelling retained without numeric conversion.</Comment><Text><![CDATA[CPT(DEMO_CALC,1e-3 + .5 + 2#101);]]></Text></Rung>
<Rung Number="29" Type="N"><Comment>Literal destination does not become a bound destination.</Comment><Text><![CDATA[CPT(123,DEMO_LEVEL + 1);]]></Text></Rung>
<Rung Number="30" Type="N"><Comment>Empty expression leaves signature unresolved.</Comment><Text><![CDATA[CPT(DEMO_CALC,);]]></Text></Rung>
<Rung Number="31" Type="N"><Comment>Wrong argument count stays unresolved.</Comment><Text>CPT(DEMO_CALC,DEMO_LEVEL,2);</Text></Rung>
<Rung Number="32" Type="N"><Comment>Mixed-case older spelling and modern spelling remain separate evidence.</Comment><Text><![CDATA[CPT(DEMO_CALC,sQr(DEMO_LEVEL) + SQRT(DEMO_LEVEL));]]></Text></Rung><Rung Number="33" Type="N"><Comment>Older inverse trigonometric spellings.</Comment><Text><![CDATA[CPT(DEMO_CALC,ACS(DEMO_LEVEL) + ASN(DEMO_LEVEL) + ATN(DEMO_LEVEL));]]></Text></Rung><Rung Number="34" Type="N"><Comment>Older conversion and truncation spellings.</Comment><Text><![CDATA[CPT(DEMO_CALC,FRD(DEMO_INDEX) + TOD(DEMO_INDEX) + TRN(DEMO_LEVEL));]]></Text></Rung><Rung Number="35" Type="N"><Comment>Nested supported functions.</Comment><Text><![CDATA[CPT(DEMO_CALC,SQR(ABS(DEMO_LEVEL)));]]></Text></Rung><Rung Number="36" Type="N"><Comment>Unsupported whole expression has no partial SQR count.</Comment><Text><![CDATA[CPT(DEMO_CALC,SQR(DEMO_LEVEL) + DEMO_PRIVATE_FN(DEMO_FLOW_PV));]]></Text></Rung><Rung Number="37" Type="N"><Comment>Known multi-argument form remains outside this single-argument grammar.</Comment><Text><![CDATA[CPT(DEMO_CALC,ATAN2(DEMO_LEVEL,DEMO_FLOW_PV));]]></Text></Rung><Rung Number="38" Type="N"><Comment>Wrong arity rejects the whole expression.</Comment><Text><![CDATA[CPT(DEMO_CALC,SQR(DEMO_LEVEL,DEMO_FLOW_PV));]]></Text></Rung><Rung Number="39" Type="N"><Comment>Only the first unsupported function is counted.</Comment><Text><![CDATA[CPT(DEMO_CALC,DEMO_PRIVATE_FN(DEMO_LEVEL) + ATAN2(DEMO_LEVEL,DEMO_FLOW_PV));]]></Text></Rung>
<Rung Number="40" Type="N"><Comment>Counter read/write; question marks are exported initialization placeholders.</Comment><Text><![CDATA[CTU(DEMO_COUNTER,?,?);]]></Text></Rung>
<Rung Number="41" Type="N"><Comment>Counter immediate text is retained without conversion or initialization.</Comment><Text><![CDATA[ctd(DEMO_COUNTER,16#0A,-1);]]></Text></Rung>
<Rung Number="42" Type="N"><Comment>Message control through an alias. Payload and remote target are not analyzed.</Comment><Text><![CDATA[MSG(DEMO_MESSAGE_ALIAS);]]></Text></Rung>
<Rung Number="43" Type="N"><Comment>Blank instance is permitted. Selector names also exist as tags but must not bind.</Comment><Text><![CDATA[GSV(Controller,,Name,DEMO_SYSTEM_ALIAS);]]></Text></Rung>
<Rung Number="44" Type="N"><Comment>Possible explicit source read only; system-object writes and ranges are not expanded.</Comment><Text><![CDATA[SSV(Program,THIS,MinorFaultRecord,DEMO_SYSTEM_DEST[0]);]]></Text></Rung>
<Rung Number="45" Type="N"><Comment>Possible explicit named-step write; chart membership and execution are not validated.</Comment><Text><![CDATA[SFR(DEMO_CHART,DEMO_STEP_ALIAS);]]></Text></Rung>
<Rung Number="46" Type="N"><Comment>Exact zero selects the initial step; no implicit step write is invented.</Comment><Text><![CDATA[SFR(DEMO_CHART,0);]]></Text></Rung>
<Rung Number="47" Type="N"><Comment>Recognized control role with an unresolved root.</Comment><Text><![CDATA[MSG(DEMO_MISSING_MESSAGE);]]></Text></Rung>
<Rung Number="48" Type="N"><Comment>Dynamic index remains a binding gap.</Comment><Text><![CDATA[GSV(Controller,,Name,DEMO_SYSTEM_DEST[DEMO_INDEX]);]]></Text></Rung>
<Rung Number="49" Type="N"><Comment>Tag-valued pseudo-field is unsupported; all instruction roles remain unknown.</Comment><Text><![CDATA[CTU(DEMO_COUNTER,DEMO_INDEX,?);]]></Text></Rung>
<Rung Number="50" Type="N"><Comment>Nonzero literal is an unbound write gap, not a valid step selection.</Comment><Text><![CDATA[SFR(DEMO_CHART,1);]]></Text></Rung>
<Rung Number="51" Type="N"><Comment>Missing class is an empty-argument gap.</Comment><Text><![CDATA[GSV(,,Name,DEMO_SYSTEM_DEST);]]></Text></Rung>
<Rung Number="52" Type="N"><Comment>Wrong arity remains unsupported.</Comment><Text><![CDATA[MSG(DEMO_MESSAGE,DEMO_COUNTER);]]></Text></Rung>
<Rung Number="53" Type="N"><Comment>Direct destination shares the alias target but preserves its suffix.</Comment><Text><![CDATA[GSV(Controller,,Name,DEMO_SYSTEM_DEST[1]);]]></Text></Rung>
<Rung Number="54" Type="N"><Comment>Two reads through the same alias stay separate; the destination is also read in its expression.</Comment><Text><![CDATA[CPT(DEMO_SELF_CALC,DEMO_EXPR_ALIAS + DEMO_EXPR_ALIAS + DEMO_SELF_CALC);]]></Text></Rung>
<Rung Number="55" Type="N"><Comment>Expression-only root appears in Tag access despite having no ordinary read operand.</Comment><Text><![CDATA[CPT(DEMO_CALC,DEMO_EXPR_ONLY * 2);]]></Text></Rung>
<Rung Number="56" Type="N"><Comment>Constant-only expression has a possible destination write and zero tag reads.</Comment><Text><![CDATA[CPT(DEMO_SELF_CALC,2 + 3);]]></Text></Rung>
<Rung Number="57" Type="N"><Comment>One structural path and a write bound to an exported module output root. Field channel meaning is not provided.</Comment><Text><![CDATA[XIC(DEMO_SENSOR_INPUT)OTE(Local:7:O.Data.0);]]></Text></Rung>
<Rung Number="58" Type="N"><Comment>One module input condition feeds two separate Boolean writes.</Comment><Text><![CDATA[XIC(Local:7:I.Data.0)[OTE(DEMO_PUMP_CMD),OTE(DEMO_VALVE_COMMAND)];]]></Text></Rung>
<Rung Number="59" Type="N"><Comment>Empty condition leg bypasses the contact, then both paths reach the latch.</Comment><Text><![CDATA[[XIC(DEMO_START),]OTL(DEMO_PUMP_CMD);]]></Text></Rung>
<Rung Number="60" Type="N"><Comment>Earlier write is retained as a structural endpoint through a trailing empty leg.</Comment><Text><![CDATA[OTE(DEMO_VALVE_COMMAND)[XIC(DEMO_STOP),];]]></Text></Rung>
<Rung Number="61" Type="N"><Comment>Known condition beside an unknown block stays partially interpreted.</Comment><Text><![CDATA[XIC(DEMO_SENSOR_INPUT)DEMO_UNKNOWN();]]></Text></Rung>
<Rung Number="62" Type="N"><Comment>Deliberately empty rung.</Comment><Text>;</Text></Rung>
<Rung Number="63" Type="N"><Comment>Deliberately malformed structure stays unparsed with no invented blocks.</Comment><Text><![CDATA[[XIC(DEMO_START)OTE(DEMO_VALVE_COMMAND);]]></Text></Rung>
<Rung><Comment>First competing note.</Comment><Comment>Second competing note.</Comment><Text><![CDATA[XIC(DEMO_START);]]></Text></Rung>
<Rung Number="65" Type="N"><Comment>PID storage member reference suggests supporting PID logic but does not establish a control loop.</Comment><Text><![CDATA[MOV(DEMO_LEVEL,DEMO_FLOW_PID.SP);]]></Text></Rung>
<Rung Number="66" Type="N"><Comment>Possible alarm-related logic from authored naming; no warning or shutdown effect is established.</Comment><Text><![CDATA[XIC(DEMO_TRIP)OTE(DEMO_LEVEL_ALARM);]]></Text></Rung>
<Rung Number="67" Type="N"><Comment>Arithmetic chain with module I/O roots. Analog channel types and scaling purpose remain unspecified.</Comment><Text><![CDATA[ADD(Local:7:I.Data.1,DEMO_LEVEL,DEMO_CALC)MUL(DEMO_CALC,2,Local:7:O.Data.1);]]></Text></Rung>
<Rung Number="68" Type="N"><Comment>Unknown helper name is only a weak PID hint.</Comment><Text><![CDATA[DEMO_PID_HELPER(DEMO_FLOW_PID,DEMO_FLOW_PV,DEMO_FLOW_OUT);]]></Text></Rung>
<Rung Number="69" Type="N"><Comment>Alarm mnemonic recognized as a family; its signature and alarm behavior remain unmodeled.</Comment><Text><![CDATA[ALMD(DEMO_ALARM_CONTROL);]]></Text></Rung>
          <Rung Number="70" Type="N"><Comment><![CDATA[Two adjacent calculation blocks reuse one exact intermediate address. Values and execution are not evaluated.]]></Comment><Text><![CDATA[ADD(DEMO_CHAIN_INPUT,1,DEMO_CHAIN_MID)MUL(DEMO_CHAIN_MID,2,DEMO_CHAIN_OUT);]]></Text></Rung>
          <Rung Number="71" Type="N"><Comment><![CDATA[Three separate expression reads share one earlier destination through an alias and direct references.]]></Comment><Text><![CDATA[ADD(DEMO_CHAIN_INPUT,1,DEMO_CHAIN_MID)CPT(DEMO_CHAIN_OUT,DEMO_CHAIN_MID+DEMO_MID_ALIAS+DEMO_CHAIN_MID);]]></Text></Rung>
          <Rung Number="72" Type="N"><Comment><![CDATA[Read-before-write occurrences stay separate; the CPT destination is not its own earlier producer.]]></Comment><Text><![CDATA[ADD(DEMO_CHAIN_INPUT,1,DEMO_CHAIN_MID)CPT(DEMO_CHAIN_MID,DEMO_CHAIN_MID+1)MUL(DEMO_CHAIN_MID,2,DEMO_CHAIN_OUT);]]></Text></Rung>
          <Rung Number="73" Type="N"><Comment><![CDATA[Another rung writes the same exact address. A cross-rung match does not establish scan order.]]></Comment><Text><![CDATA[MOV(DEMO_CHAIN_INPUT,DEMO_CHAIN_MID);]]></Text></Rung>
          <Rung Number="74" Type="N"><Comment><![CDATA[This rung reads an address written elsewhere; no local predecessor is invented.]]></Comment><Text><![CDATA[ADD(DEMO_CHAIN_MID,2,DEMO_CHAIN_OUT);]]></Text></Rung>
          <Rung Number="75" Type="N"><Comment><![CDATA[An intervening exact destination write replaces the earlier local candidate producer.]]></Comment><Text><![CDATA[ADD(DEMO_CHAIN_INPUT,1,DEMO_CHAIN_MID)MOV(DEMO_CHAIN_OTHER,DEMO_CHAIN_MID)MUL(DEMO_CHAIN_MID,2,DEMO_CHAIN_OUT);]]></Text></Rung>
          <Rung Number="76" Type="N"><Comment><![CDATA[Whole-root and member overlap is unmodeled; the earlier member destination cannot pass through the root write.]]></Comment><Text><![CDATA[ADD(DEMO_CHAIN_INPUT,1,DEMO_PAIR.Left)MOV(DEMO_CHAIN_OTHER,DEMO_PAIR)MUL(DEMO_PAIR.Left,2,DEMO_CHAIN_OUT);]]></Text></Rung>
          <Rung Number="77" Type="N"><Comment><![CDATA[Different member writes on one root conservatively stop a stale producer link; member layout is not validated.]]></Comment><Text><![CDATA[ADD(DEMO_CHAIN_INPUT,1,DEMO_PAIR.Left)MOV(DEMO_CHAIN_OTHER,DEMO_PAIR.Right)MUL(DEMO_PAIR.Left,2,DEMO_CHAIN_OUT);]]></Text></Rung>
          <Rung Number="78" Type="N"><Comment><![CDATA[Separate branch legs remain structural alternatives and are excluded from the local series-link model.]]></Comment><Text><![CDATA[[ADD(DEMO_CHAIN_INPUT,1,DEMO_CHAIN_MID),MUL(DEMO_CHAIN_MID,2,DEMO_CHAIN_OUT)];]]></Text></Rung>
          <Rung Number="79" Type="N"><Comment><![CDATA[A condition between calculation blocks is a local-link barrier in this version.]]></Comment><Text><![CDATA[ADD(DEMO_CHAIN_INPUT,1,DEMO_CHAIN_MID)XIC(DEMO_START)MUL(DEMO_CHAIN_MID,2,DEMO_CHAIN_OUT);]]></Text></Rung>
          <Rung Number="80" Type="N"><Comment><![CDATA[Unknown effects stop the local link rather than being ignored.]]></Comment><Text><![CDATA[ADD(DEMO_CHAIN_INPUT,1,DEMO_CHAIN_MID)DEMO_UNKNOWN(DEMO_CHAIN_MID)MUL(DEMO_CHAIN_MID,2,DEMO_CHAIN_OUT);]]></Text></Rung>
          <Rung Number="81" Type="N"><Comment><![CDATA[Copy ranges are not expanded; even an apparently unrelated copy block is a barrier.]]></Comment><Text><![CDATA[ADD(DEMO_CHAIN_INPUT,1,DEMO_CHAIN_MID)COP(DEMO_ARRAY[0],DEMO_ARRAY[1],1)MUL(DEMO_CHAIN_MID,2,DEMO_CHAIN_OUT);]]></Text></Rung>
          <Rung Number="82" Type="N"><Comment><![CDATA[The original resolver retains a bound root with an invalid composed bit/member suffix. Exact identity is withheld.]]></Comment><Text><![CDATA[XIC(DEMO_BIT_ALIAS.Member)OTE(DEMO_PUMP_CMD);]]></Text></Rung>
          <Rung Number="83" Type="N"><Comment><![CDATA[Static subscript spellings stay distinct in this index; this does not prove they are different runtime locations.]]></Comment><Text><![CDATA[MOV(DEMO_ARRAY[01],DEMO_CHAIN_MID)ADD(DEMO_ARRAY[1],DEMO_ARRAY[ 1 ],DEMO_CHAIN_OUT);]]></Text></Rung>
          <Rung Number="84" Type="N"><Comment><![CDATA[Operand-reuse pattern uses the same address for the condition and result.]]></Comment><Text><![CDATA[XIC(DEMO_START)OTE(DEMO_START);]]></Text></Rung>
          <Rung Number="85" Type="N"><Comment><![CDATA[Renamed addresses retain the same within-rung reuse pattern, without asserting engineering equivalence.]]></Comment><Text><![CDATA[XIC(DEMO_STOP)OTE(DEMO_STOP);]]></Text></Rung>
          <Rung Number="86" Type="N"><Comment><![CDATA[Same opcode shape but different reuse pattern: two distinct exact addresses.]]></Comment><Text><![CDATA[XIC(DEMO_START)OTE(DEMO_STOP);]]></Text></Rung>
          <Rung Number="87" Type="N"><Comment><![CDATA[Literal spelling remains part of the reuse-pattern comparison.]]></Comment><Text><![CDATA[ADD(DEMO_CHAIN_INPUT,1,DEMO_CHAIN_OUT);]]></Text></Rung>
          <Rung Number="88" Type="N"><Comment><![CDATA[A different literal does not silently join the one-unit addition pattern.]]></Comment><Text><![CDATA[ADD(DEMO_CHAIN_OTHER,2,DEMO_CHAIN_MID);]]></Text></Rung>
          <Rung Number="89" Type="N"><Comment><![CDATA[A dynamic subscript remains unresolved and prevents a guessed calculation connection.]]></Comment><Text><![CDATA[ADD(DEMO_CHAIN_INPUT,1,DEMO_CHAIN_MID)MUL(DEMO_ARRAY[DEMO_CHAIN_MID],2,DEMO_CHAIN_OUT);]]></Text></Rung>
        <Rung Number="90" Type="N"><Comment><![CDATA[Series contacts guard an ordinary output.]]></Comment><Text><![CDATA[XIC(DEMO_START)XIO(DEMO_STOP)OTE(DEMO_VALVE_COMMAND);]]></Text></Rung>
<Rung Number="91" Type="N"><Comment><![CDATA[Either branch condition can reach the final output.]]></Comment><Text><![CDATA[[XIC(DEMO_START),XIC(DEMO_PUMP_FB)]OTE(DEMO_PUMP_CMD);]]></Text></Rung>
<Rung Number="92" Type="N"><Comment><![CDATA[Nested series and parallel conditions remain grouped.]]></Comment><Text><![CDATA[XIO(DEMO_STOP)[XIC(DEMO_START),XIC(DEMO_PUMP_FB)[XIO(DEMO_TRIP),XIC(DEMO_PERMISSIVE)]]OTE(DEMO_PUMP_CMD);]]></Text></Rung>
<Rung Number="93" Type="N"><Comment><![CDATA[Outputs inside separate legs use separate incoming guards.]]></Comment><Text><![CDATA[[XIC(DEMO_START)OTE(DEMO_PUMP_CMD),XIO(DEMO_TRIP)OTL(DEMO_LEVEL_ALARM)]OTU(DEMO_VALVE_COMMAND);]]></Text></Rung>
<Rung Number="94" Type="N"><Comment><![CDATA[Empty bypass is retained beside a contact.]]></Comment><Text><![CDATA[[XIC(DEMO_START),]OTE(DEMO_PUMP_CMD);]]></Text></Rung>
<Rung Number="95" Type="N"><Comment><![CDATA[No local predicate still depends on rung entry context.]]></Comment><Text><![CDATA[OTE(DEMO_PUMP_CMD);]]></Text></Rung>
<Rung Number="96" Type="N"><Comment><![CDATA[Latch and unlatch have different normal-scan actions.]]></Comment><Text><![CDATA[XIC(DEMO_TRIP)OTL(DEMO_LEVEL_ALARM)OTU(DEMO_VALVE_COMMAND);]]></Text></Rung>
<Rung Number="97" Type="N"><Comment><![CDATA[A later read of a written address is a separate occurrence.]]></Comment><Text><![CDATA[XIC(DEMO_PUMP_CMD)OTU(DEMO_PUMP_CMD)XIC(DEMO_PUMP_CMD)OTE(DEMO_VALVE_COMMAND);]]></Text></Rung>
<Rung Number="98" Type="N"><Comment><![CDATA[Timer continuity is explicitly unmodeled here.]]></Comment><Text><![CDATA[TON(DEMO_TIMER,?,?)OTE(DEMO_PUMP_CMD);]]></Text></Rung>
<Rung Number="99" Type="N"><Comment><![CDATA[Unknown transfer remains visible even beside a bypass.]]></Comment><Text><![CDATA[[DEMO_UNKNOWN(DEMO_START),]OTE(DEMO_PUMP_CMD);]]></Text></Rung>
<Rung Number="100" Type="N"><Comment><![CDATA[A predicate binding gap differs from unknown block behavior.]]></Comment><Text><![CDATA[XIC(DEMO_MISSING_INPUT)OTE(DEMO_PUMP_CMD);]]></Text></Rung>
<Rung Number="101" Type="N"><Comment><![CDATA[Unknown target identity is separate from incoming conditions.]]></Comment><Text><![CDATA[XIC(DEMO_START)OTE(DEMO_MISSING_OUTPUT);]]></Text></Rung>
<Rung Number="102" Type="N"><Comment><![CDATA[Malformed coil signature remains an unresolved action.]]></Comment><Text><![CDATA[XIC(DEMO_START)OTE(DEMO_PUMP_CMD,DEMO_STOP)OTE(DEMO_VALVE_COMMAND);]]></Text></Rung>
<Rung Number="103" Type="N"><Comment><![CDATA[Invalid composed alias suffix stays a predicate binding gap.]]></Comment><Text><![CDATA[XIC(DEMO_BIT_ALIAS.Member)OTE(DEMO_PUMP_CMD);]]></Text></Rung>
<Rung Number="104" Type="N"><Comment><![CDATA[Wrapped limit bounds are not simplified or evaluated.]]></Comment><Text><![CDATA[LIM(20,DEMO_LEVEL,5)OTE(DEMO_LEVEL_ALARM);]]></Text></Rung>
<Rung Number="105" Type="N"><Comment><![CDATA[All comparison instructions retain individual source predicates.]]></Comment><Text><![CDATA[EQU(DEMO_LEVEL,1)NEQ(DEMO_LEVEL,2)LES(DEMO_LEVEL,3)LEQ(DEMO_LEVEL,4)GRT(DEMO_LEVEL,0)GEQ(DEMO_LEVEL,0)OTE(DEMO_LEVEL_ALARM);]]></Text></Rung>
<Rung Number="106" Type="N"><Comment><![CDATA[First scan flag remains a source condition, not an assumed value.]]></Comment><Text><![CDATA[XIC(S:FS)OTU(DEMO_LEVEL_ALARM);]]></Text></Rung>
<Rung Number="107" Type="N"><Comment><![CDATA[Module output root is context, not proof of device type.]]></Comment><Text><![CDATA[XIC(DEMO_START)OTE(Local:7:O.Data.0);]]></Text></Rung>
<Rung Number="108" Type="N"><Comment><![CDATA[Writing an input-root operand retains its unusual source context.]]></Comment><Text><![CDATA[XIC(DEMO_START)OTE(Local:7:I.Data.1);]]></Text></Rung>
<Rung Number="109" Type="N"><Comment><![CDATA[Parallel output-only legs keep their common entry condition.]]></Comment><Text><![CDATA[[OTE(DEMO_PUMP_CMD),OTU(DEMO_VALVE_COMMAND)];]]></Text></Rung>
<Rung Number="110" Type="N"><Comment><![CDATA[Unknown behavior after an output does not change its earlier guard.]]></Comment><Text><![CDATA[XIC(DEMO_START)OTE(DEMO_PUMP_CMD)DEMO_UNKNOWN(DEMO_STOP);]]></Text></Rung>
<Rung Number="111" Type="N"><Comment><![CDATA[Unknown behavior before a predicate remains in its guard.]]></Comment><Text><![CDATA[DEMO_UNKNOWN(DEMO_STOP)XIC(DEMO_START)OTE(DEMO_PUMP_CMD);]]></Text></Rung>
<Rung Number="112" Type="N"><Comment><![CDATA[Calculation transfer continuity remains explicit unknown.]]></Comment><Text><![CDATA[ADD(DEMO_CHAIN_INPUT,1,DEMO_CHAIN_MID)XIC(DEMO_START)OTE(DEMO_PUMP_CMD);]]></Text></Rung>
<Rung Number="113" Type="N"><Comment><![CDATA[Guard binds to occurrences without contradiction simplification.]]></Comment><Text><![CDATA[XIC(DEMO_START)XIO(DEMO_START)OTE(DEMO_PUMP_CMD);]]></Text></Rung>
<Rung Number="114" Type="N"><Comment><![CDATA[Nested empty branches remain represented without path expansion.]]></Comment><Text><![CDATA[[[,XIC(DEMO_START)],XIO(DEMO_STOP)]OTE(DEMO_PUMP_CMD);]]></Text></Rung>
<Rung Number="115" Type="N"><Comment><![CDATA[Invalid output target does not become a literal address.]]></Comment><Text><![CDATA[XIC(DEMO_START)OTL(1);]]></Text></Rung>
<Rung Number="116" Type="N"><Comment><![CDATA[Malformed input signature creates an opaque transfer.]]></Comment><Text><![CDATA[XIC(DEMO_START,DEMO_STOP)OTE(DEMO_PUMP_CMD);]]></Text></Rung>
<Rung Number="117" Type="N"><Comment><![CDATA[Multiple outputs share a compact guard graph.]]></Comment><Text><![CDATA[XIC(DEMO_START)[XIO(DEMO_STOP),XIC(DEMO_PERMISSIVE)]OTE(DEMO_PUMP_CMD)OTL(DEMO_LEVEL_ALARM)OTU(DEMO_VALVE_COMMAND);]]></Text></Rung>
</RLLContent></Routine>
        <Routine Name="DEMO_AUX" Type="RLL"><RLLContent>
          <Rung Number="0" Type="N"><Text><![CDATA[XIC(DEMO_PUMP_FB)OTE(DEMO_PERMISSIVE);]]></Text></Rung>
          <Rung Number="1" Type="N"><Text><![CDATA[MOV(DEMO_LEVEL,DEMO_CALC);]]></Text></Rung>
        </RLLContent></Routine>
        <Routine Name="DEMO_CHART" Type="SFC">
          <SFCContent OnlineEditType="Original">
            <Step ID="100" Operand="DEMO_WAIT"><ActionList><Action ID="110" Operand="DEMO_ACTION"><Body><STContent><Line Number="0"><![CDATA[DEMO_CALC := 0;]]></Line></STContent></Body></Action></ActionList></Step>
            <Transition ID="200" Operand="DEMO_READY"><Condition><STContent><Line Number="0"><![CDATA[DEMO_START AND DEMO_PERMISSIVE]]></Line></STContent></Condition></Transition>
            <Step ID="101" Operand="DEMO_RUN"/>
            <Transition ID="201" Operand="DEMO_STOPPING"><Condition><STContent><Line Number="0"><![CDATA[DEMO_STOP]]></Line></STContent></Condition></Transition>
            <Stop ID="102"/>
            <DirectedLink FromID="100" ToID="200"/><DirectedLink FromID="200" ToID="101"/>
            <DirectedLink FromID="101" ToID="201"/><DirectedLink FromID="201" ToID="102"/>
            <TextBox ID="300"><Text><![CDATA[Attente / Wait. This authored note remains separate from an engineering description.]]></Text></TextBox>
            <TextBox ID="301"><![CDATA[Direct-text note attached to the illustrative run step.]]></TextBox>
            <TextBox ID="302"><Text><![CDATA[Unattached note: inspect source context before deciding what it describes.]]></Text></TextBox>
            <Attachment FromID="300" ToID="100"/><Attachment FromID="301" ToID="101"/>
            <Attachment FromID="302" ToID="999"/>
          </SFCContent>
          <SFCContent OnlineEditType="PendingEdits"><Step ID="100" Operand="DEMO_WAIT_EDIT"/><TextBox ID="300"><Text><![CDATA[Separate edit namespace; no active revision selected.]]></Text></TextBox><Attachment FromID="300" ToID="100"/></SFCContent>
        </Routine>
      </Routines>
    </Program></Programs>
  </Controller>
</RSLogix5000Content>
