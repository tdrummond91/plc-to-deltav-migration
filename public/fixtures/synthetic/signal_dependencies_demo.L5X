<Rung Number="0" Type="N"><Text><![CDATA[XIC(Alarm_Input)OTE(Relay);]]></Text></Rung>
<Rung Number="1" Type="N"><Text><![CDATA[XIO(Relay)OTE(Pump_Command);]]></Text></Rung>
