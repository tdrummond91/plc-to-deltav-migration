<?xml version="1.0" encoding="UTF-8"?>
<!-- Independently invented parser input. Not controller-ready logic. -->
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.00" TargetType="Controller">
  <Controller Name="BodyContextDemo">
    <AddOnInstructionDefinitions>
      <AddOnInstructionDefinition Name="DemoBlend" Revision="1.0">
        <Description><![CDATA[Invented body ownership and access example.]]></Description>
        <Parameters>
          <Parameter Name="InputValue" DataType="REAL" Usage="Input" Required="false" Visible="false"/>
          <Parameter Name="OutputValue" DataType="REAL" Usage="Output" Required="false" Visible="true"/>
          <Parameter Name="QuietValue" DataType="REAL" Usage="Input" Required="false" Visible="false"/>
          <Parameter Name="NoObservedUse" DataType="DINT" Usage="Input" Required="false" Visible="false"/>
          <Parameter Name="AliasValue" TagType="Alias" AliasFor="Accumulator" DataType="REAL" Usage="Input" Required="false" Visible="true"/>
        </Parameters>
        <LocalTags>
          <LocalTag Name="Accumulator" DataType="REAL"/>
          <LocalTag Name="Trace" DataType="REAL" Dimensions="55"/>
          <LocalTag Name="NoObservedLocalUse" DataType="BOOL"/>
        </LocalTags>
        <Routines>
          <Routine Name="Logic" Type="RLL"><RLLContent>
        <Rung Number="0" Type="N"><Comment><![CDATA[Declared Usage and observed operand roles remain separate.]]></Comment><Text><![CDATA[MOV(InputValue,OutputValue);]]></Text></Rung>
        <Rung Number="1" Type="N"><Text><![CDATA[ADD(AliasValue,InputValue,Accumulator);]]></Text></Rung>
        <Rung Number="2" Type="N"><Text><![CDATA[CPT(OutputValue,AliasValue+InputValue+InputValue);]]></Text></Rung>
        <Rung Number="3" Type="N"><Comment><![CDATA[An unknown role is not evidence that a parameter is unused.]]></Comment><Text><![CDATA[InventedOpaque(QuietValue);]]></Text></Rung>
        <Rung Number="4" Type="N"><Comment><![CDATA[Invented pagination example 1.]]></Comment><Text><![CDATA[MOV(InputValue,Trace[0]);]]></Text></Rung>
        <Rung Number="5" Type="N"><Comment><![CDATA[Invented pagination example 2.]]></Comment><Text><![CDATA[MOV(InputValue,Trace[1]);]]></Text></Rung>
