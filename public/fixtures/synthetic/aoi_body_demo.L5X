          <Routine Name="Prescan" Type="RLL"><RLLContent>
            <Rung Number="0" Type="N"><Text><![CDATA[CLR(Accumulator);]]></Text></Rung>
          </RLLContent></Routine>
        </Routines>
      </AddOnInstructionDefinition>
      <AddOnInstructionDefinition Name="DemoText" Revision="1.0">
        <Parameters><Parameter Name="Value" DataType="DINT" Usage="InOut" Required="true" Visible="true"/></Parameters>
        <LocalTags/>
        <Routines><Routine Name="Logic" Type="ST"><STContent><Line Number="0">Value := Value + 1;</Line></STContent></Routine></Routines>
      </AddOnInstructionDefinition>
    </AddOnInstructionDefinitions>
    <Tags>
      <Tag Name="BlendInstance" TagType="Base" DataType="DemoBlend"/>
      <Tag Name="BlendAlias" TagType="Alias" AliasFor="BlendInstance"/>
      <Tag Name="BlendArray" TagType="Base" DataType="DemoBlend" Dimensions="3"/>
      <Tag Name="Container" TagType="Base" DataType="DemoBlend"/>
      <Tag Name="WrongType" TagType="Base" DataType="DINT"/>
      <Tag Name="TextInstance" TagType="Base" DataType="DemoText"/>
      <Tag Name="Cursor" TagType="Base" DataType="DINT"/>
    </Tags>
    <Programs><Program Name="Example"><Tags>
      <Tag Name="States" TagType="Base" DataType="SFC_STEP" Dimensions="4"/>
      <Tag Name="MissingStep" TagType="Base" DataType="SFC_STEP"/>
    </Tags><Routines>
      <Routine Name="Main" Type="RLL"><RLLContent>
        <Rung Number="0" Type="N"><Comment><![CDATA[Literal markup: <script>window.fixtureLeak=true</script>]]></Comment><Text><![CDATA[DemoBlend(BlendInstance);]]></Text></Rung>
        <Rung Number="1" Type="N"><Text><![CDATA[DemoBlend(BlendAlias);]]></Text></Rung>
        <Rung Number="2" Type="N"><Text><![CDATA[DemoBlend(BlendArray[1]);]]></Text></Rung>
        <Rung Number="3" Type="N"><Text><![CDATA[DemoBlend(BlendArray);]]></Text></Rung>
        <Rung Number="4" Type="N"><Text><![CDATA[DemoBlend(Container.Member);]]></Text></Rung>
        <Rung Number="5" Type="N"><Text><![CDATA[DemoBlend(WrongType);]]></Text></Rung>
        <Rung Number="6" Type="N"><Text><![CDATA[DemoBlend(MissingInstance);]]></Text></Rung>
        <Rung Number="7" Type="N"><Text><![CDATA[DemoBlend(1);]]></Text></Rung>
        <Rung Number="8" Type="N"><Text><![CDATA[DemoBlend(BlendArray[Cursor]);]]></Text></Rung>
        <Rung Number="9" Type="N"><Text><![CDATA[DemoText(TextInstance);]]></Text></Rung>
        <Rung Number="10" Type="N"><Text><![CDATA[MissingDefinition(BlendInstance);]]></Text></Rung>
        <Rung Number="11" Type="N"><Text><![CDATA[SFR(SelectedChart,States[1]);]]></Text></Rung>
        <Rung Number="12" Type="N"><Text><![CDATA[SFR(SelectedChart,States[0]);]]></Text></Rung>
        <Rung Number="13" Type="N"><Text><![CDATA[SFR(SelectedChart,MissingStep);]]></Text></Rung>
        <Rung Number="14" Type="N"><Text><![CDATA[SFR(EditedChart,States[1]);]]></Text></Rung>
      </RLLContent></Routine>
      <Routine Name="SelectedChart" Type="SFC"><SFCContent>
        <Step ID="0" Operand="States[0]" InitialStep="true"/>
      </SFCContent></Routine>
      <Routine Name="PeerChart" Type="SFC"><SFCContent>
        <Step ID="0" Operand="States[1]" InitialStep="true"/>
      </SFCContent></Routine>
      <Routine Name="EditedChart" Type="SFC">
        <SFCContent OnlineEditType="Original"><Step ID="0" Operand="States[0]" InitialStep="true"/></SFCContent>
        <SFCContent OnlineEditType="PendingEdits"><Step ID="0" Operand="States[1]" InitialStep="true"/></SFCContent>
      </Routine>
      <Routine Name="ProtectedChart" Type="SFC" SourceProtected="true"><SFCContent>
        <Step ID="0" Operand="States[1]" InitialStep="true"/>
      </SFCContent></Routine>
    </Routines></Program>
    <Program Name="OtherProgram"><Tags><Tag Name="States" TagType="Base" DataType="SFC_STEP" Dimensions="4"/></Tags><Routines>
      <Routine Name="ForeignProgramChart" Type="SFC"><SFCContent><Step ID="0" Operand="States[1]" InitialStep="true"/></SFCContent></Routine>
    </Routines></Program></Programs>
