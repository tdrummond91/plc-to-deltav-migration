      </RLLContent></Routine>
      <Routine Name="PlainRoutine" Type="RLL"><RLLContent/></Routine>
      <Routine Name="DemoChart" Type="SFC"><SFCContent>
        <Step ID="1" Operand="IdleStage" InitialStep="true"/>
        <Transition ID="2"><Condition><STContent><Line Number="0">Request;</Line></STContent></Condition></Transition>
        <Step ID="3" Operand="RunStage" InitialStep="false"/>
        <DirectedLink FromID="1" ToID="2"/><DirectedLink FromID="2" ToID="3"/>
      </SFCContent></Routine>
      <Routine Name="DuplicateChart" Type="SFC"><SFCContent>
        <Step ID="1" Operand="RunStage" InitialStep="true"/>
        <Step ID="2" Operand="RunStage" InitialStep="true"/>
      </SFCContent></Routine>
      <Routine Name="EditedChart" Type="SFC">
        <SFCContent OnlineEditType="Original"><Step ID="1" Operand="RunStage" InitialStep="true"/></SFCContent>
        <SFCContent OnlineEditType="PendingEdits"><Step ID="1" Operand="RunStage" InitialStep="true"/></SFCContent>
      </Routine>
    </Routines></Program></Programs>
  </Controller>
