<?xml version="1.0" encoding="UTF-8"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.00" TargetType="Controller" ContainsContext="true">
  <Controller Name="StatefulSequenceDemo">
    <Tags/>
    <Programs><Program Name="Demo" Type="Normal" MainRoutineName="Main"><Tags>
      <Tag Name="Request" TagType="Base" DataType="BOOL"/>
      <Tag Name="Permit" TagType="Base" DataType="BOOL"/>
      <Tag Name="PulseMemory" TagType="Base" DataType="BOOL"/>
      <Tag Name="Result" TagType="Base" DataType="BOOL"/>
      <Tag Name="Alternative" TagType="Base" DataType="BOOL"/>
      <Tag Name="ResetRequest" TagType="Base" DataType="BOOL"/>
      <Tag Name="Feed" TagType="Base" DataType="DINT"/>
      <Tag Name="Destination" TagType="Base" DataType="DINT"/>
      <Tag Name="IdleStage" TagType="Base" DataType="SFC_STEP"/>
      <Tag Name="RunStage" TagType="Base" DataType="SFC_STEP"/>
      <Tag Name="AbsentStage" TagType="Base" DataType="SFC_STEP"/>
      <Tag Name="History" TagType="Base" DataType="BOOL" Dimensions="55"/>
      <Tag Name="Results" TagType="Base" DataType="BOOL" Dimensions="55"/>
    </Tags><Routines>
      <Routine Name="Main" Type="RLL"><RLLContent>
        <Rung Number="0" Type="N"><Comment><![CDATA[State-dependent pulse condition; markup stays literal: <script>window.sourceLeak=true</script>]]></Comment><Text><![CDATA[XIC(Request)ONS(PulseMemory)OTE(Result);]]></Text></Rung>
        <Rung Number="1" Type="N"><Comment><![CDATA[A one-shot branch and a separate contact branch retain separate incoming conditions.]]></Comment><Text><![CDATA[XIC(Request)[ONS(PulseMemory)OTE(Result),XIO(Permit)OTE(Alternative)];]]></Text></Rung>
        <Rung Number="2" Type="N"><Comment><![CDATA[State-dependent input to a data move, without a coil.]]></Comment><Text><![CDATA[ONS(PulseMemory)MOV(Feed,Destination);]]></Text></Rung>
        <Rung Number="3" Type="N"><Comment><![CDATA[Repeated storage identity does not authorize evaluation of state between occurrences.]]></Comment><Text><![CDATA[ONS(PulseMemory)OTU(PulseMemory)ONS(PulseMemory)OTE(Result);]]></Text></Rung>
        <Rung Number="4" Type="N"><Comment><![CDATA[Missing storage declaration remains a binding gap.]]></Comment><Text><![CDATA[ONS(MissingStorage)OTE(Result);]]></Text></Rung>
        <Rung Number="5" Type="N"><Comment><![CDATA[A literal is not valid retained storage.]]></Comment><Text><![CDATA[ONS(1)OTE(Result);]]></Text></Rung>
        <Rung Number="6" Type="N"><Comment><![CDATA[Upstream unknown transfer remains visible.]]></Comment><Text><![CDATA[InventedUnknown(Request)ONS(PulseMemory)OTE(Result);]]></Text></Rung>
        <Rung Number="7" Type="N"><Comment><![CDATA[Named target in an SFC content.]]></Comment><Text><![CDATA[SFR(DemoChart,RunStage);]]></Text></Rung>
        <Rung Number="8" Type="N"><Comment><![CDATA[Explicit initial-step selector.]]></Comment><Text><![CDATA[XIC(ResetRequest)SFR(DemoChart,0);]]></Text></Rung>
        <Rung Number="9" Type="N"><Comment><![CDATA[Missing chart declaration.]]></Comment><Text><![CDATA[SFR(AbsentChart,RunStage);]]></Text></Rung>
        <Rung Number="10" Type="N"><Comment><![CDATA[Routine exists but is not SFC.]]></Comment><Text><![CDATA[SFR(PlainRoutine,RunStage);]]></Text></Rung>
        <Rung Number="11" Type="N"><Comment><![CDATA[Declared target tag is absent from this chart.]]></Comment><Text><![CDATA[SFR(DemoChart,AbsentStage);]]></Text></Rung>
        <Rung Number="12" Type="N"><Comment><![CDATA[Two step occurrences share an Operand in one content.]]></Comment><Text><![CDATA[SFR(DuplicateChart,RunStage);]]></Text></Rung>
        <Rung Number="13" Type="N"><Comment><![CDATA[Both Original and PendingEdits content remain visible.]]></Comment><Text><![CDATA[SFR(EditedChart,RunStage);]]></Text></Rung>
        <Rung Number="14" Type="N"><Comment><![CDATA[No active edit revision is chosen.]]></Comment><Text><![CDATA[SFR(EditedChart,0);]]></Text></Rung>
        <Rung Number="15" Type="N"><Comment><![CDATA[Independently invented pagination occurrence 1.]]></Comment><Text><![CDATA[XIC(Request)ONS(History[0])OTE(Results[0]);]]></Text></Rung>
        <Rung Number="16" Type="N"><Comment><![CDATA[Independently invented pagination occurrence 2.]]></Comment><Text><![CDATA[XIC(Request)ONS(History[1])OTE(Results[1]);]]></Text></Rung>
