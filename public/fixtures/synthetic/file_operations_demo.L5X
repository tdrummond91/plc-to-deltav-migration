<?xml version="1.0" encoding="UTF-8"?>
<!-- Entirely invented file/array analysis examples; no plant source or values. -->
<RSLogix5000Content SoftwareRevision="35.00">
<Controller Name="InventedFileOperations">
<Tags>
<Tag Name="Permit" DataType="BOOL"/>
<Tag Name="Source" DataType="DINT" Dimensions="64"/>
<Tag Name="Destination" DataType="DINT" Dimensions="64"/>
<Tag Name="Samples" DataType="REAL" Dimensions="8 8"/>
<Tag Name="Average" DataType="REAL"/>
<Tag Name="Result" DataType="REAL"/>
<Tag Name="Index" DataType="DINT"/>
<Tag Name="Mask" DataType="DINT"/>
<Tag Name="Word" DataType="DINT"/>
<Tag Name="AliasStart" TagType="Alias" AliasFor="Source[2]"/>
<Tag Name="AverageControl" DataType="CONTROL">
<Data Format="Decorated"><Structure DataType="CONTROL"><DataValueMember Name="LEN" DataType="DINT" Value="4"/><DataValueMember Name="POS" DataType="DINT" Value="0"/><DataValueMember Name="EN" DataType="BOOL" Value="0"/><DataValueMember Name="DN" DataType="BOOL" Value="0"/><DataValueMember Name="ER" DataType="BOOL" Value="0"/></Structure></Data>
</Tag>
<Tag Name="ArithmeticControl" DataType="CONTROL">
<Data Format="Decorated"><Structure DataType="CONTROL"><DataValueMember Name="LEN" DataType="DINT" Value="4"/><DataValueMember Name="POS" DataType="DINT" Value="0"/><DataValueMember Name="EN" DataType="BOOL" Value="0"/><DataValueMember Name="DN" DataType="BOOL" Value="0"/><DataValueMember Name="ER" DataType="BOOL" Value="0"/></Structure></Data>
</Tag>
<Tag Name="SequenceControl" DataType="CONTROL">
<Data Format="Decorated"><Structure DataType="CONTROL"><DataValueMember Name="LEN" DataType="DINT" Value="4"/><DataValueMember Name="POS" DataType="DINT" Value="0"/><DataValueMember Name="EN" DataType="BOOL" Value="0"/><DataValueMember Name="DN" DataType="BOOL" Value="0"/><DataValueMember Name="ER" DataType="BOOL" Value="0"/></Structure></Data>
</Tag>
</Tags><Tasks><Task Name="Task" Type="CONTINUOUS"><ScheduledPrograms><ScheduledProgram Name="Demo"/></ScheduledPrograms></Task></Tasks>
<Programs><Program Name="Demo" Type="Normal" MainRoutineName="Main"><Routines><Routine Name="Main" Type="RLL"><RLLContent OnlineEditType="Original">
<Rung Number="0" Type="N"><Comment>Qualified array copy</Comment><Text><![CDATA[XIC(Permit)COP(Source[0],Destination[0],4);]]></Text></Rung>
<Rung Number="1" Type="N"><Comment>Synchronous copy</Comment><Text><![CDATA[CPS(AliasStart,Destination[4],2);]]></Text></Rung>
<Rung Number="2" Type="N"><Comment>File average dimension selector</Comment><Text><![CDATA[AVE(Samples[0,0],1,Average,AverageControl,?,?);]]></Text></Rung>
<Rung Number="3" Type="N"><Comment>FAL symbolic destination and expression</Comment><Text><![CDATA[FAL(ArithmeticControl,?,?,ALL,Destination[ArithmeticControl.POS],Source[ArithmeticControl.POS]+Index);]]></Text></Rung>
<Rung Number="4" Type="N"><Comment>Sequencer masked destination</Comment><Text><![CDATA[SQO(Source[0],Mask,Word,SequenceControl,?,?);]]></Text></Rung>
<Rung Number="5" Type="N"><Comment>Unknown declaration</Comment><Text><![CDATA[COP(Missing[0],Destination[0],4);]]></Text></Rung>
<Rung Number="6" Type="N"><Comment>Invalid dimension remains visible</Comment><Text><![CDATA[AVE(Samples[0,0],7,Average,AverageControl,?,?);]]></Text></Rung>
<Rung Number="7" Type="N"><Comment>Invalid file arithmetic signature</Comment><Text><![CDATA[FAL(ArithmeticControl,?,?,ALL,Result);]]></Text></Rung>
<Rung Number="8" Type="N"><Comment>Unsupported expression retains full source</Comment><Text><![CDATA[FAL(ArithmeticControl,?,?,INC,Result,ATAN2(Index,2));]]></Text></Rung>
<Rung Number="9" Type="N"><Comment>Branch operations stay separate</Comment><Text><![CDATA[XIC(Permit)[COP(Source[1],Destination[2],2),CPS(Source[3],Destination[8],1)];]]></Text></Rung>
<Rung Number="10" Type="N"><Comment>Dynamic copy starts</Comment><Text><![CDATA[COP(Source[Index],Destination[Index],4);]]></Text></Rung>
<Rung Number="11" Type="N"><Comment>Negative or changing span is not evaluated</Comment><Text><![CDATA[COP(Source[0],Destination[0],Index);]]></Text></Rung>
<Rung Number="12" Type="N"><Comment>Comment is literal &lt;img src=x onerror=alert(1)&gt;</Comment><Text><![CDATA[COP(Source[0],Destination[1],1);]]></Text></Rung>
<Rung Number="13" Type="N"><Comment>Pagination example 00</Comment><Text><![CDATA[COP(Source[0],Destination[0],1);]]></Text></Rung>
<Rung Number="14" Type="N"><Comment>Pagination example 01</Comment><Text><![CDATA[COP(Source[1],Destination[1],1);]]></Text></Rung>
