<!-- Independently invented targeted diagnostic cases; never controller-ready logic.
     400 rungs exercise the exact eight-unit budget including two reserved clues. -->
<RSLogix5000Content><Controller Name="INVENTED_CONTROLLER"><Tags><Tag Name="INVENTED_SENSOR" TagType="Base" DataType="REAL"/><Tag Name="INVENTED_ARRAY" TagType="Base" DataType="REAL"/><Tag Name="INVENTED_INDEX" TagType="Base" DataType="DINT"/><Tag Name="INVENTED_OUTPUT" TagType="Base" DataType="BOOL"/><Tag Name="INVENTED_PERMIT" TagType="Base" DataType="BOOL"/><Tag Name="INVENTED_STORAGE" TagType="Base" DataType="BOOL"/><Tag Name="INVENTED_STEP" TagType="Base" DataType="SFC_STEP"/></Tags>
<Programs><Program Name="INVENTED_PROGRAM"><Routines><Routine Name="INVENTED_ROUTINE" Type="RLL"><RLLContent>
<Rung Number="0" Type="N"><Text><![CDATA[MOV(INVENTED_SENSOR,INVENTED_ARRAY[INVENTED_INDEX+1234567]);]]></Text></Rung>
<Rung Number="1" Type="N"><Text><![CDATA[MOV(INVENTED_SENSOR,INVENTED_ARRAY[(INVENTED_INDEX+7654321)*11]);]]></Text></Rung>
<Rung Number="2" Type="N"><Text><![CDATA[INVENTED_UNLISTED(INVENTED_SENSOR,INVENTED_OUTPUT);]]></Text></Rung>
<Rung Number="3" Type="N"><Text><![CDATA[XIC(INVENTED_PERMIT)ONS(INVENTED_STORAGE)OTE(INVENTED_OUTPUT);]]></Text></Rung>
<Rung Number="4" Type="N"><Text><![CDATA[SFR(INVENTED_CHART,INVENTED_STEP);]]></Text></Rung>
<Rung Number="5" Type="N"><Text><![CDATA[GRT(INVENTED_SENSOR,8765432)[XIC(INVENTED_PERMIT),XIO(INVENTED_PERMIT)]OTE(INVENTED_OUTPUT);]]></Text></Rung>
