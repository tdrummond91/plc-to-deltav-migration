<Tag Name="Wrapper" TagType="Base" DataType="InventedWrapper"></Tag>
<Tag Name="RawInput" TagType="Base" DataType="REAL"></Tag>
<Tag Name="ScaledInput" TagType="Base" DataType="REAL"></Tag>
<Tag Name="Tieback" TagType="Base" DataType="REAL"></Tag>
<Tag Name="ControlOutput" TagType="Base" DataType="REAL"></Tag>
<Tag Name="MasterOutput" TagType="Base" DataType="REAL"></Tag>
<Tag Name="InholdValue" TagType="Base" DataType="REAL"></Tag>
<Tag Name="SetpointRequest" TagType="Base" DataType="REAL"></Tag>
<Tag Name="BiasInput" TagType="Base" DataType="REAL"></Tag>
<Tag Name="OutputTarget" TagType="Base" DataType="REAL"></Tag>
<Tag Name="InputTarget" TagType="Base" DataType="REAL"></Tag>
<Tag Name="Scratch" TagType="Base" DataType="REAL"></Tag>
<Tag Name="WrongMaster" TagType="Base" DataType="REAL"></Tag>
<Tag Name="Enable" TagType="Base" DataType="BOOL"></Tag>
<Tag Name="Inhold" TagType="Base" DataType="BOOL"></Tag>
<Tag Name="ManualRequest" TagType="Base" DataType="BOOL"></Tag>
<Tag Name="Warning" TagType="Base" DataType="BOOL"></Tag>
<Tag Name="InterlockCandidate" TagType="Base" DataType="BOOL"></Tag>
<Tag Name="PrimaryAlias" TagType="Alias" DataType="PID" AliasFor="PrimaryLoop"/>
<Tag Name="SetpointAlias" TagType="Alias" DataType="REAL" AliasFor="PrimaryLoop.SP"/>
<Tag Name="OutputAlias" TagType="Alias" DataType="REAL" AliasFor="ControlOutput"/></Tags>
<Programs><Program Name="DemoProgram" MainRoutineName="Main"><Tags><Tag Name="ScaledInput" TagType="Base" DataType="REAL"></Tag></Tags>
<Routines><Routine Name="Main" Type="RLL"><RLLContent><Rung Number="0" Type="N"><Comment>Invented connection evidence. A master reference does not prove active cascade.</Comment><Text>XIC(Enable)PID(PrimaryLoop,ScaledInput,Tieback,ControlOutput,MasterLoop,Inhold,InholdValue);</Text></Rung>
<Rung Number="1" Type="N"><Text>PID(MasterLoop,RawInput,0,MasterOutput,0,0,0);</Text></Rung>
<Rung Number="2" Type="N"><Comment>Repeated invocation through an alias.</Comment><Text>PID(PrimaryAlias,ScaledInput,0,ControlOutput,0,0,0);</Text></Rung>
<Rung Number="3" Type="N"><Comment>A direct setpoint write through an alias.</Comment><Text>MOV(SetpointRequest,SetpointAlias);</Text></Rung>
<Rung Number="4" Type="N"><Text>CPT(PrimaryLoop.SP,RawInput + BiasInput);</Text></Rung>
<Rung Number="5" Type="N"><Text>XIC(ManualRequest)OTE(PrimaryLoop.SWM);</Text></Rung>
<Rung Number="6" Type="N"><Comment>Alarm-field use is not proof of a plant warning classification.</Comment><Text>XIC(PrimaryLoop.PVHA)OTE(Warning);</Text></Rung>
<Rung Number="7" Type="N"><Comment>A possible downstream action; shutdown purpose remains unconfirmed.</Comment><Text>XIC(PrimaryLoop.DVNA)OTL(InterlockCandidate);</Text></Rung>
<Rung Number="8" Type="N"><Text>MOV(OutputAlias,OutputTarget);</Text></Rung>
<Rung Number="9" Type="N"><Text>MUL(InputTarget,2,ScaledInput);</Text></Rung>
<Rung Number="10" Type="N"><Comment>Nested or indexed member references remain distinct from direct scalar fields.</Comment><Text>MOV(PrimaryLoop.DATA[0],Scratch);</Text></Rung>
<Rung Number="11" Type="N"><Comment>Whole-root copy use does not establish writes to each member.</Comment><Text>COP(PrimaryLoop,MasterLoop,1);</Text></Rung>
<Rung Number="12" Type="N"><Comment>Unknown direct member spelling remains a gap.</Comment><Text>MOV(BiasInput,PrimaryLoop.CustomFlag);</Text></Rung>
<Rung Number="13" Type="N"><Text>PID(OtherLoop,ScaledInput,0,ControlOutput,NoInvocationMaster,0,0);</Text></Rung>
<Rung Number="14" Type="N"><Text>PID(ArrayLoop[0],ScaledInput,0,ControlOutput,MasterLoop,0,0);</Text></Rung>
<Rung Number="15" Type="N"><Comment>Self master reference is retained, not accepted as a valid loop design.</Comment><Text>PID(PrimaryLoop,ScaledInput,0,ControlOutput,PrimaryLoop,0,0);</Text></Rung>
<Rung Number="16" Type="N"><Text>PID(OtherLoop,ScaledInput,0,ControlOutput,WrongMaster,0,0);</Text></Rung>
<Rung Number="17" Type="N"><Text>PID(OtherLoop,ScaledInput,0,ControlOutput,MissingMaster,0,0);</Text></Rung>
<Rung Number="18" Type="N"><Text>PID(OtherLoop,ScaledInput,0,ControlOutput,Wrapper.Loop,0,0);</Text></Rung>
<Rung Number="19" Type="N"><Comment>Deliberately malformed signature remains visible.</Comment><Text>PID(PrimaryLoop,ScaledInput,0,ControlOutput,0,0);</Text></Rung>
<Rung Number="20" Type="N"><Comment>Unknown operand roles remain unknown.</Comment><Text>InventedOperation(ControlOutput);</Text></Rung>
<Rung Number="21" Type="N"><Text>CPT(Scratch,ControlOutput + PrimaryLoop.SP);</Text></Rung>
<Rung Number="22" Type="N"><Text>MOV(PrimaryLoop.SP,MasterLoop.SP);</Text></Rung>
<Rung Number="23" Type="N"><Comment>ASCII case variants refer to the same catalog field.</Comment><Text>MOV(PrimaryLoop.sp,Scratch);</Text></Rung>
<Rung Number="24" Type="N"><Comment>&lt;script&gt;window.fixtureLeak=true&lt;/script&gt; must display as text.</Comment><Text>MOV(0,PrimaryLoop.SP);</Text></Rung>
<Rung Number="25" Type="N"><Text>MOV(1,PrimaryLoop.SP);</Text></Rung>
<Rung Number="26" Type="N"><Text>MOV(2,PrimaryLoop.SP);</Text></Rung>
<Rung Number="27" Type="N"><Text>MOV(3,PrimaryLoop.SP);</Text></Rung>
