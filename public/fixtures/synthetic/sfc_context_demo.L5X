<Routine Name="Main" Type="RLL"><RLLContent>
<Rung Number="0" Type="N"><Text><![CDATA[XIC(Gate)OTE(StepA.X);]]></Text></Rung>
<Rung Number="1" Type="N"><Text><![CDATA[XIC(StepA.X)OTL(Gate);]]></Text></Rung>
<Rung Number="2" Type="N"><Text><![CDATA[ADD(StepA.T,1,StepA.T);]]></Text></Rung>
<Rung Number="3" Type="N"><Text><![CDATA[CPT(Result,StepA.T+2);]]></Text></Rung>
<Rung Number="4" Type="N"><Text><![CDATA[INVENTED_BLOCK(StepA.X);]]></Text></Rung>
<Rung Number="5" Type="N"><Text><![CDATA[OTU(StepAlias.X);]]></Text></Rung>
<Rung Number="6" Type="N"><Text x:Name="foreign-name"><![CDATA[OTE(StepA.X);]]></Text></Rung>
</RLLContent></Routine>
