<?xml version="1.0" encoding="UTF-8"?>
<!-- Independently invented for calculation-report checks. Not controller-ready logic. -->
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="35.00" TargetName="CalculationPathsDemo" TargetType="Controller" ContainsContext="true">
<Controller Name="CalculationPathsDemo"><Tags>
<Tag Name="Source" TagType="Base" DataType="REAL"/>
<Tag Name="Alternate" TagType="Base" DataType="REAL"/>
<Tag Name="Buffer" TagType="Base" DataType="REAL"/>
<Tag Name="Output" TagType="Base" DataType="REAL"/>
<Tag Name="Spare" TagType="Base" DataType="REAL"/>
<Tag Name="Result" TagType="Base" DataType="REAL"/>
<Tag Name="Enable" TagType="Base" DataType="BOOL"/>
<Tag Name="Index" TagType="Base" DataType="DINT"/>
<Tag Name="Array" TagType="Base" DataType="REAL" Dimensions="8"/>
<Tag Name="Record" TagType="Base" DataType="InventedRecord"/>
<Tag Name="Delay" TagType="Base" DataType="TIMER"/>
<Tag Name="IntermediateAlias" TagType="Alias" AliasFor="Buffer"/>
</Tags><Programs><Program Name="Demonstration" MainRoutineName="Examples"><Routines><Routine Name="Examples" Type="RLL"><RLLContent>
<Rung Number="0" Type="N"><Comment>Straight calculation chain</Comment><Text>MOV(Source,Buffer)ADD(Buffer,1,Output);</Text></Rung>
<Rung Number="1" Type="N"><Comment>Independent sibling segments</Comment><Text>[MOV(Source,Buffer)MUL(Buffer,2,Output),MOV(Alternate,Buffer)DIV(Buffer,2,Spare)];</Text></Rung>
<Rung Number="2" Type="N"><Comment>Fork and join stop prior-writer links</Comment><Text>MOV(Source,Buffer)[ADD(Buffer,1,Output),ADD(Buffer,2,Spare)]SUB(Buffer,1,Result);</Text></Rung>
<Rung Number="3" Type="N"><Comment>A predicate changes the incoming condition</Comment><Text>MOV(Source,Buffer)XIC(Enable)CPT(Output,Buffer+Buffer);</Text></Rung>
<Rung Number="4" Type="N"><Comment>Different members invalidate the remembered root writer</Comment><Text>MOV(Source,Record.A)MOV(Alternate,Record.B)ADD(Record.A,1,Output);</Text></Rung>
<Rung Number="5" Type="N"><Comment>A timer separates calculation segments</Comment><Text>MOV(Source,Buffer)TON(Delay,100,0)ADD(Buffer,1,Output);</Text></Rung>
<Rung Number="6" Type="N"><Comment>An unknown block is a boundary</Comment><Text>MOV(Source,Buffer)INVENTED_BLOCK(Record)ADD(Buffer,1,Output);</Text></Rung>
<Rung Number="7" Type="N"><Comment>Nested branches retain separate segments</Comment><Text>[MOV(Source,Buffer)[ADD(Buffer,1,Output),MUL(Buffer,2,Spare)]MOV(Output,Result),MOV(Alternate,Buffer)MOV(Buffer,Output)];</Text></Rung>
<Rung Number="8" Type="N"><Comment>An alias resolves to the exact intermediate address</Comment><Text>MOV(Source,Buffer)MOV(IntermediateAlias,Output);</Text></Rung>
<Rung Number="9" Type="N"><Comment>Read before write and repeated expression leaves</Comment><Text>MOV(Source,Buffer)CPT(Buffer,Buffer+Buffer)MOV(Buffer,Output);</Text></Rung>
<Rung Number="10" Type="N"><Comment>Clear has a destination without a data input</Comment><Text>CLR(Buffer)ADD(Buffer,1,Output);</Text></Rung>
<Rung Number="11" Type="N"><Comment>Dynamic selectors remain unresolved for exact reuse</Comment><Text>MOV(Source,Array[Index])ADD(Array[Index],1,Output);</Text></Rung>
<Rung Number="12" Type="N"><Comment>Malformed and unresolved inputs remain visible</Comment><Text>ADD(Source)MOV(Missing,Output)CPT(Spare,InventedFunction(Source));</Text></Rung>
<Rung Number="13" Type="N"><Comment>Exact member spelling is preserved</Comment><Text>MOV(Source,Record.SP)MOV(Record.sp,Output);</Text></Rung>
<Rung Number="14" Type="N"><Comment>An empty bypass does not merge candidate writers</Comment><Text>MOV(Source,Buffer)[,MOV(Alternate,Buffer)]MOV(Buffer,Output);</Text></Rung>
<Rung Number="15" Type="N"><Comment>All supported calculation spellings</Comment><Text>ABS(Source,Buffer)LN(Buffer,Output)SQR(Output,Spare)SUB(Spare,1,Result);</Text></Rung>
<Rung Number="16" Type="N"><Comment>Markup is source text: &lt;script&gt;window.fixtureLeak=true&lt;/script&gt;</Comment><Text>MOV(Source,Buffer)MOV(Buffer,Output);</Text></Rung>
<Rung Number="17" Type="N"><Comment>Invented paging case 1</Comment><Text>MOV(Source,Buffer)ADD(Buffer,1,Output);</Text></Rung>
<Rung Number="18" Type="N"><Comment>Invented paging case 2</Comment><Text>MOV(Source,Buffer)ADD(Buffer,1,Output);</Text></Rung>
